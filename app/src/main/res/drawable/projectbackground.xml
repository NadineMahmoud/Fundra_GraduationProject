<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- First Layer: Vertical gradient (0deg) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1A000000"
                android:endColor="#1A000000"
            android:type="linear" />
        </shape>
    </item>

    <!-- Second Layer: Angled gradient (~81.85deg) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="98"
                android:type="linear"
                android:startColor="#33000000"
            android:centerColor="#26000000"
            android:endColor="#1A000000"
            />
        </shape>
    </item>

</layer-list>




