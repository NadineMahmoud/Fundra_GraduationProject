<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    tools:context=".AddCampaignActivity">
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="36dp"
        android:layout_height="37dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/back_btn"
        android:contentDescription="@string/back"
        android:padding="10dp"
        android:src="@drawable/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <FrameLayout
        android:id="@+id/campaign_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/frame"
                android:padding="20dp"
                android:gravity="center_horizontal">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/warning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/error"
                        android:background="@android:color/transparent"
                        android:layout_marginStart="10dp" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_campaign"
                        android:textColor="@color/black1"
                        android:fontFamily="@font/open_sans_bold"
                        android:textStyle="bold"
                        android:textSize="30sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/campaign_titleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|top"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/text_sign"
                        android:elevation="2dp"
                        android:padding="8dp"
                        android:text="@string/campaign_title"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <!-- TextInput -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/campaign_title_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:hintEnabled="false"
                        app:endIconMode="clear_text"
                        app:endIconTintMode="src_in">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/campaign_titleET"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/signupbox"
                            android:fontFamily="@font/open_sans_semibold"
                            android:textSize="14sp"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:paddingTop="24dp"
                            android:textColor="@color/black1"
                            android:inputType="text"
                            android:hint="@string/enter_campaign_title"
                            android:textColorHint="@color/white"
                            app:hintTextColor="@color/white"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
                <!-- Email Field -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:id="@+id/revenueLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|top"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/text_sign"
                        android:elevation="1dp"
                        android:paddingHorizontal="15dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="8dp"
                        android:text="@string/revenue_share_percentage"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/revenueLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        app:endIconMode="clear_text"
                        app:endIconTintMode="src_in"
                        app:hintEnabled="false"
                        app:hintTextColor="@android:color/white"
                        android:textColorHint="@android:color/white">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/revenueET"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/signupbox"
                            android:fontFamily="@font/open_sans_semibold"
                            android:textSize="14sp"
                            android:scrollHorizontally="true"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:hint="@string/add_your_percentage"
                            android:textColorHint="@color/white"
                            android:paddingTop="24dp"
                            app:hintTextColor="@color/white"
                            android:textColor="@color/black1"
                            android:inputType="text"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:id="@+id/FundingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|top"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/text_sign"
                        android:elevation="2dp"
                        android:padding="6dp"
                        android:text="@string/funding_goal"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/FundingLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            app:endIconTintMode="src_in"
                            android:layout_weight="1"
                            app:hintEnabled="false">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/FundingET"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/signupbox"
                                android:fontFamily="@font/open_sans_semibold"
                                android:inputType="textLongMessage"
                                android:hint="@string/add_goal"
                                android:paddingTop="23dp"
                                android:scrollHorizontally="true"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:textColor="@color/black1"
                                app:hintTextColor="@android:color/white"
                                android:textColorHint="@android:color/white"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/returnLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginTop="15dp"
                            android:layout_marginStart="10dp"
                            app:endIconMode="clear_text"
                            android:background="@drawable/signupbox"
                            app:endIconTintMode="src_in"
                            app:hintTextColor="@android:color/white"
                            android:textColorHint="@android:color/white">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/return_ET"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/add_return"
                                android:maxLines="1"
                                android:padding="15dp"
                                android:background="@color/transparent_black"
                                android:textColorHint="@color/white"
                                android:textColor="@color/black1"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/MultipleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="68dp"
                        android:background="@drawable/text_sign"
                        android:elevation="2dp"
                        android:padding="6dp"
                        android:layout_marginTop="5dp"
                        android:text="@string/return_multiple"
                        android:textColor="@color/black1"
                        android:textSize="12sp"
                        android:layout_gravity="center|top"
                        android:fontFamily="@font/open_sans_bold" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:id="@+id/DurationLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|top"
                        android:layout_marginStart="15dp"
                        android:background="@drawable/text_sign"
                        android:elevation="2dp"
                        android:padding="6dp"
                        android:text="@string/expected_duration"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/DurationLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginTop="15dp"
                            app:endIconTintMode="src_in"
                            app:hintEnabled="false">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/DurationET"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingTop="23dp"
                                android:scrollHorizontally="true"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:background="@drawable/signupbox"
                                android:fontFamily="@font/open_sans_semibold"
                                android:inputType="number"
                                android:textColor="@color/black1"
                                android:hint="Write a Number"
                                app:hintTextColor="@android:color/white"
                                android:textColorHint="@android:color/white"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/Min_InvestLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:layout_marginTop="15dp"
                            app:endIconTintMode="src_in"
                            app:hintEnabled="false">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/Min_Invest"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingTop="22dp"
                                android:scrollHorizontally="true"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:background="@drawable/signupbox"
                                android:fontFamily="@font/open_sans_semibold"
                                android:inputType="number"
                                android:textColor="@color/black1"
                                android:hint="@string/write_a_number"
                                app:hintTextColor="@android:color/white"
                                android:textColorHint="@android:color/white"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/Min_InvestLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="70dp"
                        android:background="@drawable/text_sign"
                        android:elevation="2dp"
                        android:padding="6dp"
                        android:text="@string/min_invest"
                        android:textColor="@color/black1"
                        android:textSize="12sp"
                        android:layout_gravity="center|top"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/open_sans_bold" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/upload"
                            android:layout_width="0dp"
                            android:layout_height="63dp"
                            android:layout_weight="1"
                            android:text="@string/upload_image"
                            android:drawableEnd="@drawable/upload"
                            android:paddingStart="7dp"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/black1"
                            android:drawableTintMode="src_over"
                            android:background="@drawable/upload_box"
                            app:backgroundTint="@null"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/Social_Media_LinksLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="7dp"
                            app:hintEnabled="false"
                            android:inputType="textLongMessage"
                            android:layout_weight="1">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/Social_Media_LinksET"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/signupbox"
                                android:fontFamily="@font/open_sans_semibold"
                                android:inputType="textLongMessage"
                                android:paddingTop="22dp"
                                android:scrollHorizontally="true"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:hint="@string/attach_here" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/Social_Media_LinksLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|top"
                        android:layout_marginStart="75dp"
                        android:background="@drawable/text_sign"
                        android:elevation="2dp"
                        android:fontFamily="@font/open_sans_bold"
                        android:padding="6dp"
                        android:layout_marginTop="-6dp"
                        android:text="@string/social_media_links"
                        android:textColor="@color/black1"
                        android:textSize="12sp" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <CheckBox
                        android:id="@+id/checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_bold"
                        android:text=""
                        android:layout_marginTop="12dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black1"
                        android:fontFamily="@font/open_sans_semibold"
                        android:textSize="15sp"
                        android:layout_marginTop="13dp"
                        android:text="@string/i_agree_to_the_processing_of"/>
                    <TextView
                        android:id="@+id/Privacy_Policies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:layout_marginTop="13dp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:text=" Privacy policies"
                        android:textColor="@color/navy_blue"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_up_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="8dp"
                    android:textSize="18sp"
                    android:text="@string/add_campaign"
                    android:fontFamily="@font/open_sans_bold"
                    android:background="@drawable/sign_btn"
                    app:backgroundTint="@null" />
            </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>