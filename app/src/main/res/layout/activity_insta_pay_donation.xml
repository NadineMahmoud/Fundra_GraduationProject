<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InstaPayDonationActivity" android:background="@drawable/main_bg">
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/back"
        android:src="@drawable/back"
        android:background="@drawable/back_btn"
        android:padding="10dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <TextView
        android:id="@+id/vodafone_tx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/instapay"
        android:textColor="@color/black1"
        android:fontFamily="@font/open_sans_bold"
        android:textSize="20sp"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <FrameLayout
        android:id="@+id/campaign_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/frame"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copy_these_info_to_make_an_instapay_transfer"
                android:textSize="19sp"
                android:layout_margin="10dp"
                android:textColor="@color/black1"
                android:fontFamily="@font/open_sans_bold"/>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/transparent_blue"
                android:background="@color/transparent_blue"
                android:layout_marginTop="10dp"
                app:strokeColor="#8024C6E4"
                app:cardCornerRadius="20dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="20dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/open_sans_bold"
                        android:text="@string/make_a_transfer_using_this_refrence"
                        android:textColor="@color/black1"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/copy_this_reference_to_instapay_transfer_notes"
                        android:fontFamily="@font/open_sans_semibold"
                        android:layout_gravity="center"
                        android:textSize="12sp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/copied"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:layout_marginEnd="10dp"
                            android:fontFamily="@font/open_sans_bold"
                            android:text="@string/nadine454545" />
                        <ImageButton
                            android:id="@+id/copy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/copy"
                            android:src="@drawable/copy"
                            android:background="@color/transparent_black"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bank_name"
                android:layout_gravity="start"
                android:textSize="20sp"
                android:layout_marginTop="20dp"
                android:textColor="@color/black1"
                android:fontFamily="@font/open_sans_bold"/>
            <TextView
                android:id="@+id/copeidOne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/banque_misr"
                android:textSize="16sp"
                android:textColor="@color/black1"
                android:layout_gravity="start"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/open_sans_semibold"/>
            <ImageButton
                android:id="@+id/copy_one"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/copy"
                android:src="@drawable/copy"
                android:layout_marginTop="-25dp"
                android:background="@color/transparent_black"
                android:layout_gravity="end"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4D092F37"
                android:layout_marginTop="15dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_number"
                android:layout_gravity="start"
                android:textSize="20sp"
                android:layout_marginTop="20dp"
                android:textColor="@color/black1"
                android:fontFamily="@font/open_sans_bold"/>
            <TextView
                android:id="@+id/copiesTwo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_102993863444"
                android:textSize="16sp"
                android:textColor="@color/black1"
                android:layout_gravity="start"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/open_sans_semibold"/>
            <ImageButton
                android:id="@+id/copy_two"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/copy"
                android:src="@drawable/copy"
                android:layout_marginTop="-25dp"
                android:background="@color/transparent_black"
                android:layout_gravity="end"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4D092F37"
                android:layout_marginTop="15dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/receiver_name"
                android:layout_gravity="start"
                android:textSize="20sp"
                android:layout_marginTop="20dp"
                android:textColor="@color/black1"
                android:fontFamily="@font/open_sans_bold"/>
            <TextView
                android:id="@+id/copiedThree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fundra"
                android:textSize="16sp"
                android:textColor="@color/black1"
                android:layout_gravity="start"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/open_sans_semibold"/>
            <ImageButton
                android:id="@+id/copy_three"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/copy"
                android:src="@drawable/copy"
                android:layout_marginTop="-25dp"
                android:background="@color/transparent_black"
                android:layout_gravity="end"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4D092F37"
                android:layout_marginTop="15dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:layout_marginTop="80dp"
                android:textSize="20sp"
                android:text="@string/confirm_deposit"
                app:cornerRadius="100dp"
                android:fontFamily="@font/open_sans_bold"
                android:background="@drawable/sign_btn"
                app:backgroundTint="@null"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>