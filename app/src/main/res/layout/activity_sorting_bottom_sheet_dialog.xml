<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Sorting_BottomSheet_Dialog_activity">

    <FrameLayout
        android:id="@+id/frame_donation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/sorting_frame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        android:elevation="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="1.0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="30dp"
        android:background="@drawable/sorting_frame"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sorting_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/delete"
                android:layout_marginEnd="15dp"
                android:fontFamily="@font/open_sans_regular"
                android:textColor="@color/navy_blue"
                android:textSize="17sp"
                app:layout_constraintTop_toTopOf="@id/sorting_frame"
                app:layout_constraintEnd_toEndOf="@id/sorting_frame"/>

            <TextView
                android:id="@+id/sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort By"
                android:layout_marginStart="15dp"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/open_sans_semibold"
                android:textColor="@color/black"
                app:layout_constraintBottom_toTopOf="@id/categories"
                app:layout_constraintTop_toTopOf="@id/sorting_frame"
                app:layout_constraintStart_toStartOf="@id/sorting_frame"/>

            <TextView
                android:id="@+id/categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/open_sans_bold"
                app:layout_constraintBottom_toTopOf="@id/food"
                app:layout_constraintTop_toBottomOf="@id/sort"
                app:layout_constraintStart_toStartOf="@id/sorting_frame"/>
            <TextView
                android:id="@+id/deselectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deselect all"
                android:fontFamily="@font/open_sans_regular"
                android:textColor="@color/navy_blue"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"
                android:textSize="17sp"
                app:layout_constraintTop_toBottomOf="@id/delete"
                app:layout_constraintEnd_toEndOf="@id/sorting_frame"/>
            <CheckBox
                android:id="@+id/food"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food and Community development"
                android:textColor="@color/black"
                android:layout_marginStart="10dp"
                android:textSize="16sp"
                android:fontFamily="@font/open_sans_bold"
                app:layout_constraintBottom_toTopOf="@id/Hospitals"
                app:layout_constraintTop_toBottomOf="@id/categories"
                app:layout_constraintStart_toStartOf="@id/sorting_frame"/>

            <CheckBox
                android:id="@+id/Hospitals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hospitals and Medical Aids"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/open_sans_bold"
                app:layout_constraintBottom_toTopOf="@id/AlZakah"
                app:layout_constraintTop_toBottomOf="@id/food"
                app:layout_constraintStart_toStartOf="@id/sorting_frame"/>

            <CheckBox
                android:id="@+id/AlZakah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Al Zakah and Al Sadakat"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:padding="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/open_sans_bold"
                app:layout_constraintBottom_toTopOf="@id/results_btn"
                app:layout_constraintTop_toBottomOf="@id/Hospitals"
                app:layout_constraintStart_toStartOf="@id/sorting_frame"/>

            <TextView
                android:id="@+id/selectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select all"
                android:fontFamily="@font/open_sans_regular"
                android:textColor="@color/navy_blue"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"
                android:textSize="17sp"
                android:layout_marginBottom="30dp"
               app:layout_constraintBottom_toTopOf="@id/results_btn"
                app:layout_constraintEnd_toEndOf="@id/sorting_frame"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/results_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:text="Results"
                android:padding="10dp"
                android:layout_marginHorizontal="10dp"
                app:cornerRadius="100dp"
                android:fontFamily="@font/open_sans_bold"
                android:background="@drawable/sign_btn"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="@id/sorting_frame"
                app:layout_constraintStart_toStartOf="@id/sorting_frame"
                app:layout_constraintEnd_toEndOf="@id/sorting_frame"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>