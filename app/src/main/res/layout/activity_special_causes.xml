<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/main_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Special_CausesActivity">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/back"
        android:src="@drawable/back"
        android:background="@drawable/back_btn"
        android:padding="10dp"
        android:layout_marginTop="70dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        android:id="@+id/donation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Baheya"
        android:fontFamily="@font/open_sans_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="75dp"
        app:layout_constraintBottom_toTopOf="@id/frame_donation"
        android:textSize="20sp"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/search"
        android:padding="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="60dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/frame_donation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/frame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/donation"
        app:layout_constraintVertical_bias="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="20dp"
            android:background="@drawable/frame"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="10dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cases_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/special_tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Special causes"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@id/cases_container"
                    app:layout_constraintEnd_toEndOf="@id/cases_container"
                    app:layout_constraintTop_toTopOf="@id/cases_container"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/first_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_case"
                    android:backgroundTint="@color/card_case"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="40dp"
                    app:layout_constraintTop_toBottomOf="@id/special_tx"
                    app:layout_constraintStart_toStartOf="@id/cases_container"
                    app:layout_constraintEnd_toEndOf="@id/cases_container">
                    <ImageView
                        android:id="@+id/image_case_one"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/case_one"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/view"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="-5dp"
                        android:layout_marginBottom="-10dp"
                        android:layout_gravity="bottom"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center"
                        android:layout_marginTop="-30dp"
                        android:layout_marginEnd="20dp"
                        android:orientation="horizontal">
                    
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/donate"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/back_btn"
                        android:padding="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Donate"
                            android:textSize="16sp"
                            android:layout_marginEnd="10dp"
                            android:layout_gravity="center"
                            android:textColor="@color/black1"
                            android:fontFamily="@font/open_sans_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center"
                        android:layout_marginTop="30dp"
                        android:layout_marginEnd="40dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/save_donation"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/back_btn"
                            android:padding="14dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save"
                            android:textSize="16sp"
                            android:layout_marginEnd="10dp"
                            android:layout_gravity="center"
                            android:textColor="@color/black1"
                            android:fontFamily="@font/open_sans_bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/second_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_case"
                    android:backgroundTint="@color/card_case"
                    android:layout_marginTop="30dp"
                    app:cardCornerRadius="40dp"
                    app:layout_constraintTop_toBottomOf="@id/first_card"
                    app:layout_constraintStart_toStartOf="@id/cases_container"
                    app:layout_constraintEnd_toEndOf="@id/cases_container">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/case_two"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/view_two"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="-5dp"
                        android:layout_marginBottom="-10dp"
                        android:layout_gravity="bottom"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center"
                        android:layout_marginTop="-30dp"
                        android:layout_marginEnd="20dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/donate"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/back_btn"
                            android:padding="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Donate"
                            android:textSize="16sp"
                            android:layout_marginEnd="10dp"
                            android:layout_gravity="center"
                            android:textColor="@color/black1"
                            android:fontFamily="@font/open_sans_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center"
                        android:layout_marginTop="30dp"
                        android:layout_marginEnd="40dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/save_donation"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/back_btn"
                            android:padding="14dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save"
                            android:textSize="16sp"
                            android:layout_marginEnd="10dp"
                            android:layout_gravity="center"
                            android:textColor="@color/black1"
                            android:fontFamily="@font/open_sans_bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/third_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_case"
                    android:backgroundTint="@color/card_case"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="40dp"
                    app:layout_constraintTop_toBottomOf="@id/second_card"
                    app:layout_constraintStart_toStartOf="@id/cases_container"
                    app:layout_constraintEnd_toEndOf="@id/cases_container">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/case_three"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/view_three"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="-5dp"
                        android:layout_marginBottom="-10dp"
                        android:layout_gravity="bottom"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center"
                        android:layout_marginTop="-30dp"
                        android:layout_marginEnd="20dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/donate"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/back_btn"
                            android:padding="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Donate"
                            android:textSize="16sp"
                            android:layout_marginEnd="10dp"
                            android:layout_gravity="center"
                            android:textColor="@color/black1"
                            android:fontFamily="@font/open_sans_bold"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center"
                        android:layout_marginTop="30dp"
                        android:layout_marginEnd="40dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/save_donation"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/back_btn"
                            android:padding="14dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save"
                            android:textSize="16sp"
                            android:layout_marginEnd="10dp"
                            android:layout_gravity="center"
                            android:textColor="@color/black1"
                            android:fontFamily="@font/open_sans_bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/menu_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        android:elevation="100dp"
        android:background="@drawable/menu_shape"
        app:itemIconTint="@color/bottom_nav_item_color"
        android:backgroundTint="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />



</androidx.constraintlayout.widget.ConstraintLayout>