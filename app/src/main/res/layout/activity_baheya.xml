<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BaheyaActivity"
    android:background="@drawable/main_bg">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/back"
        android:src="@drawable/back"
        android:background="@drawable/back_btn"
        android:padding="10dp"
        android:layout_marginTop="60dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        android:id="@+id/donation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/donation"
        android:fontFamily="@font/open_sans_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="70dp"
        app:layout_constraintBottom_toTopOf="@id/frame_donation"
        android:textSize="20sp"/>
    


    <FrameLayout
        android:id="@+id/frame_donation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/donation_frame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/donation"
        app:layout_constraintVertical_bias="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp"
            android:background="@drawable/donation_frame"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="10dp">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/donation_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/charity_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Baheya"
                    android:textColor="@color/black1"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="24sp"
                    app:layout_constraintStart_toStartOf="@id/donation_container"
                    app:layout_constraintTop_toTopOf="@id/donation_container"/>

                <ImageView
                    android:id="@+id/charity_image"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/baheyaa"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toTopOf="@id/selection_card"
                    app:layout_constraintEnd_toEndOf="@id/donation_container"
                    app:layout_constraintTop_toTopOf="@id/donation_container"/>



                <androidx.cardview.widget.CardView
                    android:id="@+id/selection_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    app:cardCornerRadius="20dp"
                    app:contentPadding="10dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/white"
                    app:layout_constraintTop_toBottomOf="@id/charity_image"
                    app:layout_constraintStart_toStartOf="@id/donation_container"
                    app:layout_constraintBottom_toTopOf="@id/Mobile_Number"
                    app:layout_constraintEnd_toEndOf="@id/donation_container">

                    <TextView
                        android:id="@+id/select"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select a Cause"
                        android:textSize="15sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginBottom="30dp"
                        android:textColor="@color/black1"
                        android:fontFamily="@font/open_sans_bold"/>
                    <Spinner
                        android:id="@+id/spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown"
                        android:padding="25dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/spinner_bg"
                        android:layout_marginTop="40dp" />
                </androidx.cardview.widget.CardView>
                <TextView
                    android:id="@+id/Mobile_Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile Number"
                    android:textSize="15sp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/open_sans_bold"
                    app:layout_constraintStart_toStartOf="@id/donation_container"
                    app:layout_constraintTop_toBottomOf="@id/selection_card"/>
                         <androidx.cardview.widget.CardView
                              android:id="@+id/mobile_card"
                              android:layout_width="match_parent"
                              android:layout_height="wrap_content"
                              app:cardCornerRadius="10dp"
                             android:layout_marginTop="10dp"
                             android:layout_marginHorizontal="10dp"
                              android:background="@color/white"
                             android:layout_marginStart="8dp"
                             android:layout_marginEnd="8dp"
                              app:layout_constraintBottom_toTopOf="@id/amount"
                             app:layout_constraintStart_toStartOf="@id/donation_container"
                             app:layout_constraintEnd_toEndOf="@id/donation_container"
                              app:layout_constraintTop_toBottomOf="@id/Mobile_Number">


                              <ImageView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:src="@drawable/phone_"
                                  android:layout_margin="20dp"/>
                              <EditText
                                  android:layout_width="match_parent"
                                  android:layout_height="match_parent"
                                  android:background="@null"
                                  android:paddingHorizontal="15dp"
                                  android:textColorHint="@color/hint"
                                  android:textSize="15sp"
                                  android:inputType="numberDecimal"
                                  android:padding="15dp"
                                  android:layout_marginStart="60dp"
                                  android:layout_marginEnd="20dp"
                                  android:layout_marginTop="10dp"/>
                          </androidx.cardview.widget.CardView>
                <TextView
                    android:id="@+id/amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/open_sans_bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/mobile_card" />

                                    <androidx.cardview.widget.CardView
                              android:id="@+id/amount_card"
                              android:layout_width="match_parent"
                              android:layout_height="wrap_content"
                              android:padding="15dp"
                              android:layout_marginHorizontal="10dp"
                              app:cardCornerRadius="10dp"
                              android:layout_marginStart="8dp"
                              android:layout_marginEnd="8dp"
                              android:layout_marginTop="10dp"
                              android:background="@color/white"
                              app:layout_constraintEnd_toEndOf="@id/donation_container"
                              app:layout_constraintStart_toStartOf="@id/donation_container"
                              app:layout_constraintBottom_toTopOf="@id/pay"
                              app:layout_constraintTop_toBottomOf="@id/amount">

                              <ImageView
                                  android:layout_width="wrap_content"
                                  android:layout_height="wrap_content"
                                  android:src="@drawable/amount"
                                  android:layout_gravity="start|center"
                                  android:layout_margin="20dp"/>

                              <EditText
                                  android:id="@+id/amountEditText"
                                  android:layout_width="match_parent"
                                  android:layout_height="match_parent"
                                  android:hint="Enter an Amount (5-60000)EGP"
                                  android:paddingHorizontal="15dp"
                                  android:textColorHint="@color/hint"
                                  android:textSize="15sp"
                                  android:background="@null"
                                  android:inputType="numberDecimal"
                                  android:padding="15dp"
                                  android:layout_marginBottom="10dp"
                                  android:layout_marginStart="60dp"
                                  android:layout_marginEnd="20dp"
                                  android:layout_marginTop="10dp" />
                                    </androidx.cardview.widget.CardView>

                               <TextView
                                    android:id="@+id/pay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pay with"
                                    android:textColor="@color/black1"
                                    android:textSize="15sp"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginTop="20dp"
                                    android:fontFamily="@font/open_sans_bold"
                                    app:layout_constraintStart_toStartOf="@id/donation_container"
                                    app:layout_constraintTop_toBottomOf="@id/amount_card"/>

                            <RadioGroup
                                android:id="@+id/radioGroup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                app:tint = "@color/navy_blue"
                                android:layout_marginBottom="10dp"
                                app:layout_constraintBottom_toTopOf="@id/donate_btn"
                                app:layout_constraintTop_toBottomOf="@id/pay"
                                app:layout_constraintStart_toStartOf="@id/donation_container"
                                android:orientation="vertical">
                                <RadioButton
                                    android:id="@+id/fizza"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="XXXX-3328"
                                    android:textColor="@color/black1"
                                    android:drawablePadding="10dp"
                                    android:drawableStart="@drawable/logos_mastercard"
                                    android:textSize="15sp"
                                    android:paddingHorizontal="5dp"
                                    android:fontFamily="@font/open_sans_semibold"/>
                                <RadioButton
                                    android:id="@+id/credit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Another credit/debit Card"
                                    android:drawablePadding="10dp"
                                    android:drawableStart="@drawable/fizza"
                                    android:textSize="15sp"
                                    android:textColor="@color/black1"
                                    android:paddingHorizontal="5dp"
                                    android:fontFamily="@font/open_sans_semibold"/>
                            </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/donate_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:text="Donate"
                    app:cornerRadius="100dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:background="@drawable/sign_btn"
                    app:backgroundTint="@null"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="10dp"
                    app:layout_constraintTop_toBottomOf="@id/radioGroup"
                    app:layout_constraintStart_toStartOf="@id/donation_container"
                    app:layout_constraintEnd_toEndOf="@id/donation_container"
                    app:layout_constraintBottom_toBottomOf="@id/donation_container"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>