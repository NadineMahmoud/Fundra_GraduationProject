        <!-- Notification Icon -->
        <ImageButton
            android:id="@+id/notification"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/back_btn"
            android:src="@drawable/notification"
            android:contentDescription="Notifications"
            app:layout_constraintBottom_toTopOf="@id/search"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/points_card"
        android:layout_width="93dp"
        android:layout_height="41dp"
        android:layout_marginEnd="20sp"
        android:layout_marginTop="57dp"
        android:elevation="0dp"
        app:cardCornerRadius="50dp"
        app:strokeColor="@color/transparent_black"
        android:backgroundTint="#32092F37"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/notification"
        android:background="#80092F37">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/stars"
            android:background="@drawable/back_btn"
            android:padding="10dp"/>
        <TextView
            android:id="@+id/points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1902"
            android:fontFamily="@font/open_sans_semibold"
            android:layout_marginEnd="10dp"
            android:textColor="#CC092F37"
            android:layout_gravity="end|center"/>
    </com.google.android.material.card.MaterialCardView>

        <!-- Welcome Text -->
        <TextView
            android:id="@+id/welcome_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome"
            android:textColor="#092F37"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginTop="50dp"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toTopOf="@id/userText"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- User Name Text -->
        <TextView
            android:id="@+id/userText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Hello, Nadine"
            android:textSize="15sp"
            android:textColor="#000000"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/welcome_text"
            app:layout_constraintStart_toStartOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="50dp"
        app:cardElevation="4dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/userText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/card_layout">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:iconifiedByDefault="false"
            android:queryHint="Search and invest anywhere..."
            android:background="@android:color/transparent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp" />
    </androidx.cardview.widget.CardView>

