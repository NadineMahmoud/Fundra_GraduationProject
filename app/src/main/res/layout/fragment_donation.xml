<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/main_bg">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/back"
        android:src="@drawable/back"
        android:background="@drawable/back_btn"
        android:padding="10dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        android:id="@+id/donation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/donation"
        android:fontFamily="@font/open_sans_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="40dp"
        android:textSize="20sp"/>

    <ImageView
        android:id="@+id/filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/filter"
        android:background="@drawable/back_btn"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="40dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="50dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/donation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/frame_donation">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:iconifiedByDefault="false"
            style="@style/CustomSearchViewStyle"
            app:queryHint="Search / donate anywhere"
            android:background="@color/white"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp" />
    </androidx.cardview.widget.CardView>
    <FrameLayout
        android:id="@+id/frame_donation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/donation_frame"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search"
        app:layout_constraintVertical_bias="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp"
            android:background="@drawable/donation_frame"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

                <TextView
                    android:id="@+id/categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="Categories"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/donation_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/baheya"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/baheya"
                    app:layout_constraintTop_toTopOf="@id/donation_container"
                    app:layout_constraintBottom_toTopOf="@id/baheya_tx"
                    app:layout_constraintEnd_toStartOf="@id/magdy"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="@id/donation_container" />

                <TextView
                    android:id="@+id/baheya_tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:text="Baheya"
                    android:textAlignment="center"
                    android:textColor="@color/black_donation"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="@id/baheya"
                    app:layout_constraintStart_toStartOf="@id/baheya"
                    app:layout_constraintTop_toBottomOf="@id/baheya" />

                <ImageView
                    android:id="@+id/magdy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/magdy"
                    app:layout_constraintBottom_toTopOf="@id/magdy_tx"
                    app:layout_constraintEnd_toStartOf="@id/elnas"
                    app:layout_constraintStart_toEndOf="@id/baheya"
                    app:layout_constraintTop_toTopOf="@id/donation_container"/>

                <TextView
                    android:id="@+id/magdy_tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:text="Magdi\nyacoub"
                    android:textAlignment="center"
                    android:textColor="@color/black_donation"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="@id/magdy"
                    app:layout_constraintStart_toStartOf="@id/magdy"
                    app:layout_constraintTop_toBottomOf="@id/magdy" />


                <ImageView
                    android:id="@+id/elnas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/elnas"
                    app:layout_constraintBottom_toTopOf="@id/elnas_tx"
                    app:layout_constraintEnd_toStartOf="@id/seven_five"
                    app:layout_constraintStart_toEndOf="@id/magdy"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/elnas_tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:text="AlNas\nHospital"
                    android:textAlignment="center"
                    android:textColor="@color/black_donation"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/seven_five_tx"
                    app:layout_constraintStart_toEndOf="@id/magdy_tx"
                    app:layout_constraintTop_toBottomOf="@id/elnas" />

                <ImageView
                    android:id="@+id/seven_five"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/seven"
                    app:layout_constraintBottom_toTopOf="@id/seven_five_tx"
                    app:layout_constraintEnd_toStartOf="@id/ahl_masr"
                    app:layout_constraintStart_toEndOf="@id/elnas"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/seven_five_tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:text="57357\nHospital"
                    android:textAlignment="center"
                    android:textColor="@color/black_donation"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="@id/seven_five"
                    app:layout_constraintStart_toStartOf="@id/seven_five"
                    app:layout_constraintTop_toBottomOf="@id/seven_five" />

                <ImageView
                    android:id="@+id/ahl_masr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/masr"
                    app:layout_constraintBottom_toTopOf="@id/ahl_masr_tx"
                    app:layout_constraintEnd_toEndOf="@id/donation_container"
                    app:layout_constraintStart_toEndOf="@id/seven_five"
                    app:layout_constraintTop_toTopOf="@id/donation_container"/>

                <TextView
                    android:id="@+id/ahl_masr_tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:text="Ahl Masr"
                    android:textAlignment="center"
                    android:textColor="@color/black_donation"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="@id/donation_container"
                    app:layout_constraintStart_toStartOf="@id/ahl_masr"
                    app:layout_constraintTop_toBottomOf="@id/ahl_masr" />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>