<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InstaPayActivity"
    android:background="@drawable/main_bg">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/back"
        android:src="@drawable/back"
        android:background="@drawable/back_btn"
        android:padding="10dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        android:id="@+id/vodafone_tx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="InstaPay"
        android:textColor="@color/black1"
        android:fontFamily="@font/open_sans_bold"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/vodafone_frame"/>
    <FrameLayout
        android:id="@+id/vodafone_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/frame"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy these info to make an InstaPay transfer:"
            android:textSize="19sp"
            android:layout_margin="10dp"
            android:textColor="@color/black1"
            android:fontFamily="@font/open_sans_bold"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/transparent_blue"
            android:background="@color/transparent_blue"
            android:layout_marginTop="10dp"
            app:strokeColor="#8024C6E4"
            app:cardCornerRadius="20dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="Make a transfer using this refrence"
                    android:textColor="@color/black1"
                    android:textSize="14sp" />

                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                android:text="Copy this reference to InstaPay transfer notes"
                android:fontFamily="@font/open_sans_semibold"
                android:layout_gravity="center"
                android:textSize="12sp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="Nadine454545" />
            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/copy"
                android:background="@color/transparent_black"/>
            </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bank Name"
            android:layout_gravity="start"
            android:textSize="20sp"
            android:layout_marginTop="20dp"
            android:textColor="@color/black1"
            android:fontFamily="@font/open_sans_bold"/>
        <TextView
            android:id="@+id/copeidOne"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Banque Misr"
            android:textSize="16sp"
            android:textColor="@color/black1"
            android:layout_gravity="start"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/open_sans_semibold"/>
        <ImageButton
            android:id="@+id/copy_one"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/copy"
            android:layout_marginTop="-25dp"
            android:background="@color/transparent_black"
            android:layout_gravity="end"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4D092F37"
            android:layout_marginTop="15dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Number"
            android:layout_gravity="start"
            android:textSize="20sp"
            android:layout_marginTop="20dp"
            android:textColor="@color/black1"
            android:fontFamily="@font/open_sans_bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="102993863444"
            android:textSize="16sp"
            android:textColor="@color/black1"
            android:layout_gravity="start"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/open_sans_semibold"/>
        <ImageButton
            android:id="@+id/copy_two"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/copy"
            android:layout_marginTop="-25dp"
            android:background="@color/transparent_black"
            android:layout_gravity="end"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4D092F37"
            android:layout_marginTop="15dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receiver Name"
            android:layout_gravity="start"
            android:textSize="20sp"
            android:layout_marginTop="20dp"
            android:textColor="@color/black1"
            android:fontFamily="@font/open_sans_bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fundra"
            android:textSize="16sp"
            android:textColor="@color/black1"
            android:layout_gravity="start"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/open_sans_semibold"/>
        <ImageButton
            android:id="@+id/copy_three"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/copy"
            android:layout_marginTop="-25dp"
            android:background="@color/transparent_black"
            android:layout_gravity="end"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4D092F37"
            android:layout_marginTop="15dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:layout_marginTop="190dp"
            android:textSize="20sp"
            android:text="Confirm Deposit"
            app:cornerRadius="100dp"
            android:fontFamily="@font/open_sans_bold"
            android:background="@drawable/sign_btn"
            app:backgroundTint="@null"/>


    </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>