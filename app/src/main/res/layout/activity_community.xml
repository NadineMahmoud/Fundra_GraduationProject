<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/main_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CommunityActivity">
    <ImageButton
        android:id="@+id/filterutton"
        android:layout_width="36dp"
        android:layout_height="37dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/back_btn"
        android:contentDescription="@string/back"
        android:padding="15dp"
        android:src="@drawable/filter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/profile"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/profile_two"
        android:layout_marginEnd="10dp"
        android:background="@color/transparent_black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="45dp"/>

    <TextView
        android:id="@+id/posts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Posts"
        android:paddingEnd="15dp"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textSize="20sp"
        android:layout_margin="20dp"
        android:textColor="@color/black1"
        android:fontFamily="@font/open_sans_bold"
        android:background="@drawable/community_text"
        app:layout_constraintEnd_toStartOf="@id/following"
        app:layout_constraintTop_toBottomOf="@id/filterutton"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/following"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Following"
        android:paddingEnd="15dp"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textSize="20sp"
        android:layout_margin="20dp"
        android:textColor="@color/black1"
        android:fontFamily="@font/open_sans_bold"
        android:background="@drawable/community_text"
        app:layout_constraintEnd_toStartOf="@id/reels"
        app:layout_constraintStart_toEndOf="@id/posts"
        app:layout_constraintTop_toBottomOf="@id/filterutton"/>
    <TextView
        android:id="@+id/reels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reels"
        android:paddingEnd="15dp"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textSize="20sp"
        android:layout_margin="22dp"
        android:textColor="@color/black1"
        android:fontFamily="@font/open_sans_bold"
        android:background="@drawable/community_text"
        app:layout_constraintEnd_toEndOf="@id/posts"
        app:layout_constraintStart_toEndOf="@id/following"
        app:layout_constraintTop_toBottomOf="@id/filterutton"/>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/following"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
